@baseUrl = http://localhost:3000

### 1. GET - Mengambil semua kursus
GET {{baseUrl}}/kursus

### 2. GET - Mengambil kursus berdasarkan ID
GET {{baseUrl}}/kursus/1

### 3. POST - Menambahkan kursus
POST {{baseUrl}}/kursus
Content-Type: application/json

{
  "nama": "Bahasa Korea",
  "level": "Pemula",
  "jadwal": "Jumat, 19.00",
  "harga": 225000,
  "halamanDetail": "detail-inggris.html"
}

### 4. PATCH - Mengubah kursus
PATCH {{baseUrl}}/kursus/5
Content-Type: application/json

{
  "harga": 250000
}

### 5. DELETE - Menghapus kursus
DELETE {{baseUrl}}/kursus/5

### 6. ERROR - Mencari kursus yang tidak tersedia
GET {{baseUrl}}/kursus/999

### 7. ERROR - Menambahkan kursus duplikat
POST {{baseUrl}}/kursus
Content-Type: application/json

{
  "nama": "Bahasa Inggris",
  "level": "Pemula",
  "jadwal": "Senin & Rabu, 19.00",
  "harga": 199999,
  "halamanDetail": "detail-inggris.html"
}

### 8. ERROR - Validasi harga
POST {{baseUrl}}/kursus
Content-Type: application/json

{
  "nama": "Bahasa Korea",
  "level": "Pemula",
  "jadwal": "Jumat, 19.00",
  "harga": -100,
  "halamanDetail": "detail-inggris.html"
}